{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "regions": ["fra1"],
  "services": {
    "web": {
      "root": "apps/web/",
      "framework": "vite",
      "buildCommand": "yarn workspace @super/shared build && yarn build",
      "outputDirectory": "dist",
      "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
    },
    "api": {
      "root": "apps/api/",
      "framework": "nestjs",
      "entrypoint": "server.js",
      "buildCommand": "yarn workspace @super/shared build && yarn build:vercel",
      "functions": { "server.js": { "maxDuration": 300 } }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ],
  "crons": [{ "path": "/api/tareas/sincronizar-catalogo", "schedule": "0 3 * * *" }]
}
